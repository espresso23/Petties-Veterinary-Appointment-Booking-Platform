// =============================================================================
// PETTIES DATABASE SCHEMA - POSTGRESQL ONLY
// =============================================================================
// Project: Petties - Veterinary Appointment Booking Platform
// Generated: 2026-03-09
// Version: 2.0
//
// Scope:
// - Spring Boot backend PostgreSQL tables
// - AI service PostgreSQL tables
// - MongoDB collections are documented separately in SRS/SDD
// =============================================================================

Project Petties {
  database_type: 'PostgreSQL'
  Note: '''
    Petties PostgreSQL schema inventory synchronized with current codebase.

    Backend tables: 21
    AI service tables: 5

    MongoDB collections such as emr_records, vaccination_records,
    chat_conversations, chat_messages, ai_chat_sessions, and ai_chat_messages
    are intentionally excluded from this DBML because they belong to the
    NoSQL design section.
  '''
}

// =============================================================================
// ENUMS
// =============================================================================

Enum role {
  PET_OWNER
  STAFF
  CLINIC_MANAGER
  CLINIC_OWNER
  ADMIN
}

Enum staff_specialty {
  MEDICAL
  GROOMER
}

Enum clinic_status {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

Enum pet_species {
  DOG
  CAT
  BIRD
  RABBIT
  HAMSTER
  FISH
  OTHER
}

Enum service_category {
  GROOMING_SPA
  VACCINATION
  CHECK_UP
  SURGERY
  DENTAL
  DERMATOLOGY
  OTHER
}

Enum target_species {
  DOG
  CAT
  BOTH
}

Enum auto_reply_condition {
  OFF_HOURS
  ALWAYS
}

Enum slot_status {
  AVAILABLE
  BOOKED
  BLOCKED
}

Enum booking_type {
  IN_CLINIC
  HOME_VISIT
  SOS
}

Enum booking_status {
  PENDING
  SEARCHING
  PENDING_CLINIC_CONFIRM
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

Enum payment_method {
  CASH
  QR
  CARD
}

Enum payment_status {
  PENDING
  PAID
  REFUNDED
  FAILED
}

Enum notification_type {
  APPROVED
  REJECTED
  PENDING
  CLINIC_PENDING_APPROVAL
  STAFF_SHIFT_ASSIGNED
  STAFF_SHIFT_UPDATED
  STAFF_SHIFT_DELETED
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_CHECKIN
  BOOKING_COMPLETED
  STAFF_ON_WAY
  STAFF_ARRIVED
  BOOKING_ASSIGNED
  CLINIC_VERIFIED
  RE_EXAMINATION_REMINDER
  VACCINATION_REMINDER
  BOOKING_REMINDER [note: 'In DB CHECK constraint, not yet in JPA enum']
  SYSTEM [note: 'In DB CHECK constraint, not yet in JPA enum']
  PROMOTION [note: 'In DB CHECK constraint, not yet in JPA enum']
}

Enum tooltype {
  CODE_BASED
  API_BASED
}

// =============================================================================
// TABLE GROUPS
// =============================================================================

TableGroup auth_user {
  users
  refresh_tokens
  blacklisted_tokens
}

TableGroup pet_management {
  pets
}

TableGroup clinic_management {
  clinics
  clinic_images
  clinic_price_per_km
  chat_auto_reply_settings
}

TableGroup service_management {
  master_services
  clinic_services
  service_weight_prices
  vaccine_templates
  vaccine_dose_prices
}

TableGroup scheduling {
  staff_shifts
  slots
}

TableGroup booking_management {
  bookings
  booking_services
  booking_slots
  payments
  reviews
}

TableGroup operations {
  notifications
}

TableGroup ai_service {
  agents
  tools
  prompt_versions
  knowledge_documents
  system_settings
}

// =============================================================================
// BACKEND TABLES
// =============================================================================

Table users {
  user_id uuid [pk]
  username varchar(50) [not null, unique]
  password varchar(255) [not null]
  phone varchar(20) [unique]
  email varchar(100) [unique]
  full_name varchar(100)
  avatar varchar(500)
  avatar_public_id varchar(100)
  role role [not null]
  specialty staff_specialty
  rating_avg decimal(2,1)
  rating_count int
  fcm_token varchar(500)
  address varchar(500)
  working_clinic_id uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    username [unique, name: 'idx_users_username']
    email [unique, name: 'idx_users_email']
    phone [unique, name: 'idx_users_phone']
    (role) [name: 'idx_users_role']
    (working_clinic_id) [name: 'idx_users_working_clinic']
  }

  Note: 'System users with soft delete support'
}

Table refresh_tokens {
  token_id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamp [not null]
  created_at timestamp [not null]

  indexes {
    (user_id) [name: 'idx_refresh_tokens_user_id']
    token_hash [unique, name: 'idx_refresh_tokens_token_hash']
  }
}

Table blacklisted_tokens {
  token_id uuid [pk]
  token_hash varchar(255) [not null, unique]
  user_id uuid [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null]

  indexes {
    token_hash [unique, name: 'idx_blacklisted_tokens_token_hash']
    (user_id) [name: 'idx_blacklisted_tokens_user_id']
  }
}

Table pets {
  pet_id uuid [pk]
  name varchar(255) [not null]
  species pet_species [not null]
  breed varchar(255) [not null]
  date_of_birth date [not null]
  weight decimal(10,2) [not null]
  gender varchar(50) [not null]
  color varchar(100)
  allergies text
  image_url varchar(500)
  image_public_id varchar(100)
  user_id uuid [not null]
  created_at timestamp [not null]
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (user_id) [name: 'idx_pets_user_id']
  }

  Note: 'Pet profiles with soft delete support'
}

Table clinics {
  clinic_id uuid [pk]
  owner_id uuid [not null]
  name varchar(200) [not null]
  description text
  address varchar(500) [not null]
  ward varchar(100)
  district varchar(100)
  province varchar(100)
  specific_location varchar(200)
  phone varchar(20) [not null]
  email varchar(100)
  bank_name varchar(100)
  account_number varchar(50)
  latitude decimal(10,8)
  longitude decimal(11,8)
  logo varchar(500)
  business_license_url varchar(500)
  operating_hours jsonb
  status clinic_status [not null]
  rejection_reason text
  rating_avg decimal(2,1)
  rating_count int
  approved_at timestamp
  created_at timestamp [not null]
  updated_at timestamp
  deleted_at timestamp
  version bigint [default: 0, note: 'Optimistic locking']

  indexes {
    (owner_id) [name: 'idx_clinics_owner_id']
    (status) [name: 'idx_clinics_status']
    (latitude, longitude) [name: 'idx_clinics_location']
  }

  Note: 'Clinics with soft delete, JSON operating hours, and optimistic locking'
}

Table clinic_images {
  image_id uuid [pk]
  clinic_id uuid [not null]
  image_url varchar(500) [not null]
  caption varchar(200)
  display_order int
  is_primary boolean
  created_at timestamp [not null]

  indexes {
    (clinic_id) [name: 'idx_clinic_images_clinic_id']
  }
}

Table clinic_price_per_km {
  clinic_id uuid [pk]
  price_per_km decimal(12,2)
  sos_fee decimal(12,2)
  version bigint [not null, default: 0, note: 'Optimistic locking']
  created_at timestamp
  updated_at timestamp

  Note: 'One-to-one pricing config for home visit and SOS distance fee. Uses @MapsId (shares PK with clinics) and @Version for optimistic locking.'
}

Table master_services {
  master_service_id uuid [pk]
  name varchar(200) [not null]
  description text
  default_price decimal(19,2) [not null]
  duration_time int [not null]
  slots_required int [not null]
  is_home_visit boolean [not null]
  default_price_per_km decimal(19,2)
  service_category varchar(100)
  pet_type varchar(100)
  icon varchar(100)
  created_at timestamp [not null]
  updated_at timestamp
}

Table vaccine_templates {
  vaccine_template_id uuid [pk]
  name varchar(100) [not null]
  manufacturer varchar(100)
  description text
  default_price decimal(19,2)
  min_age_weeks int
  repeat_interval_days int
  series_doses int
  is_annual_repeat boolean
  min_interval_days int
  target_species target_species [not null]
  created_at timestamp [not null]
  updated_at timestamp
}

Table clinic_services {
  service_id uuid [pk]
  clinic_id uuid [not null]
  master_service_id uuid
  is_custom boolean [not null, default: true]
  name varchar(200) [not null]
  description text
  base_price decimal(19,2) [not null]
  duration_time int [not null]
  slots_required int [not null]
  is_active boolean [not null, default: true]
  is_home_visit boolean [not null, default: false]
  reminder_interval int
  reminder_unit varchar(50)
  service_category service_category
  pet_type varchar(100)
  vaccine_template_id uuid
  created_at timestamp [not null]
  updated_at timestamp
  version bigint [default: 0, note: 'Optimistic locking']

  indexes {
    (clinic_id) [name: 'idx_clinic_services_clinic_id']
    (master_service_id) [name: 'idx_clinic_services_master_service_id']
    (service_category) [name: 'idx_clinic_services_category']
    (is_active) [name: 'idx_clinic_services_active']
    (vaccine_template_id) [name: 'idx_clinic_services_vaccine_template']
  }
}

Table service_weight_prices {
  weight_price_id uuid [pk]
  service_id uuid
  master_service_id uuid
  min_weight decimal(10,2) [not null]
  max_weight decimal(10,2) [not null]
  price decimal(19,2) [not null]
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (service_id) [name: 'idx_service_weight_prices_service_id']
    (master_service_id) [name: 'idx_service_weight_prices_master_service_id']
  }
}

Table vaccine_dose_prices {
  id uuid [pk]
  service_id uuid [not null]
  dose_number int [not null]
  dose_label varchar(50)
  price decimal(19,2) [not null]
  is_active boolean
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (service_id, dose_number) [unique, name: 'uk_vaccine_dose_prices_service_dose']
  }
}

Table chat_auto_reply_settings {
  setting_id uuid [pk]
  clinic_id uuid [not null]
  quick_reply_enabled boolean [not null]
  quick_reply_message text
  away_message_enabled boolean [not null]
  away_condition auto_reply_condition [not null]
  away_message text
  action_buttons text
  created_at timestamp [not null]
  updated_at timestamp
}

Table staff_shifts {
  shift_id uuid [pk]
  staff_id uuid [not null]
  clinic_id uuid [not null]
  work_date date [not null]
  start_time time [not null]
  end_time time [not null]
  break_start time
  break_end time
  is_overnight boolean [not null]
  notes varchar(500)
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (staff_id, work_date) [name: 'idx_shift_staff_date']
    (clinic_id, work_date) [name: 'idx_shift_clinic_date']
  }
}

Table slots {
  slot_id uuid [pk]
  shift_id uuid [not null]
  start_time time [not null]
  end_time time [not null]
  status slot_status [not null]
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (shift_id) [name: 'idx_slot_shift']
    (status) [name: 'idx_slot_status']
    (start_time, end_time) [name: 'idx_slot_time']
  }
}

Table bookings {
  booking_id uuid [pk]
  version bigint
  booking_code varchar(20) [not null, unique]
  pet_id uuid [not null]
  pet_owner_id uuid [not null]
  clinic_id uuid [note: 'Nullable for SOS while searching']
  assigned_staff_id uuid
  proxy_booker_id uuid
  booking_date date [not null]
  booking_time time [not null]
  type booking_type [not null]
  home_address varchar(500)
  home_lat decimal(10,7)
  home_long decimal(10,7)
  distance_km decimal(5,2)
  distance_fee decimal(12,2)
  sos_fee decimal(12,2)
  total_price decimal(12,2) [not null]
  status booking_status [not null]
  cancellation_reason varchar(255)
  cancelled_by uuid
  notes text
  symptoms text
  confirmed_at timestamp
  arrived_at timestamp
  created_at timestamp

  indexes {
    booking_code [unique, name: 'idx_bookings_code']
    (pet_owner_id) [name: 'idx_bookings_pet_owner']
    (clinic_id) [name: 'idx_bookings_clinic']
    (assigned_staff_id) [name: 'idx_bookings_staff']
    (status) [name: 'idx_bookings_status']
    (booking_date) [name: 'idx_bookings_date']
  }
}

Table booking_services {
  booking_service_id uuid [pk]
  booking_id uuid [not null]
  pet_id uuid [note: 'Nullable for backward compatibility']
  service_id uuid [not null]
  unit_price decimal(12,2) [not null]
  base_price decimal(12,2)
  weight_price decimal(12,2)
  quantity int [not null, default: 1]
  is_add_on boolean [default: false]
  created_at timestamp
  assigned_staff_id uuid

  indexes {
    (booking_id) [name: 'idx_booking_services_booking']
    (service_id) [name: 'idx_booking_services_service']
    (pet_id) [name: 'idx_booking_services_pet']
  }
}

Table booking_slots {
  booking_slot_id uuid [pk]
  booking_id uuid [not null]
  slot_id uuid [not null]
  booking_service_id uuid
  created_at timestamp

  indexes {
    (booking_id) [name: 'idx_booking_slots_booking']
    (slot_id) [name: 'idx_booking_slots_slot']
  }
}

Table payments {
  payment_id uuid [pk]
  booking_id uuid [not null, unique]
  amount decimal(12,2) [not null]
  payment_description varchar(100)
  method payment_method [not null]
  status payment_status [not null]
  stripe_payment_id varchar(255)
  paid_at timestamp
  created_at timestamp

  indexes {
    (booking_id) [unique, name: 'idx_payments_booking']
    (status) [name: 'idx_payments_status']
  }
}

Table reviews {
  review_id uuid [pk]
  rating int [not null]
  comment text
  booking_id uuid [not null, unique]
  clinic_id uuid [not null]
  user_id uuid [not null]
  created_at timestamp

  Note: 'Present in current JPA model; keep synchronized with Flyway migration plan'
}

Table notifications {
  notification_id uuid [pk]
  user_id uuid [not null]
  clinic_id uuid
  shift_id uuid
  type notification_type [not null]
  emr_id varchar(50)
  message text [not null]
  reason text
  read boolean [not null, default: false]
  action_type varchar(100)
  action_data text
  created_at timestamp [not null]

  indexes {
    (user_id) [name: 'idx_notification_user']
    (type) [name: 'idx_notification_type']
    (read) [name: 'idx_notification_read']
  }
}

// =============================================================================
// AI SERVICE TABLES
// =============================================================================

Table agents {
  id int [pk, increment]
  name varchar(100) [not null, unique]
  description text
  temperature float
  max_tokens int
  top_p float
  model varchar(100)
  system_prompt text
  enabled boolean
  created_at timestamptz
  updated_at timestamptz

  indexes {
    name [unique, name: 'idx_agents_name']
  }
}

Table tools {
  id int [pk, increment]
  name varchar(100) [not null, unique]
  description text
  tool_type tooltype [note: 'PostgreSQL enum: CODE_BASED, API_BASED']
  input_schema json
  output_schema json
  enabled boolean [note: 'Scanner/seed may auto-enable tools based on current policy; playground-safe tools can still be toggled by admin']
  assigned_agents json [note: 'Logical relation to agents by agent name list; currently system-managed to petties_agent, not a foreign key']
  created_at timestamptz
  updated_at timestamptz

  indexes {
    name [unique, name: 'idx_tools_name']
  }
}

Table prompt_versions {
  id int [pk, increment]
  agent_id int [not null]
  version int [not null]
  prompt_text text [not null]
  is_active boolean
  created_by varchar(100)
  notes text
  created_at timestamptz
}

Table knowledge_documents {
  id int [pk, increment]
  filename varchar(255) [not null]
  file_path varchar(500) [not null]
  file_type varchar(10) [note: 'pdf, docx, txt, md']
  file_size int
  processed boolean
  vector_count int
  uploaded_by varchar(100)
  notes text
  uploaded_at timestamptz
  processed_at timestamptz

  Note: 'Standalone PostgreSQL metadata table for RAG documents; embeddings are stored in Qdrant'
}

Table system_settings {
  id int [pk, increment]
  key varchar(100) [not null, unique]
  value text [not null]
  category varchar(50) [note: 'Allowed values: llm, rag, embeddings, vector_db, general']
  is_sensitive boolean
  description text
  created_at timestamptz
  updated_at timestamptz

  indexes {
    key [unique, name: 'idx_system_settings_key']
  }

  Note: 'Standalone runtime configuration table for AI service'
}

// =============================================================================
// RELATIONSHIPS
// =============================================================================

Ref users_working_clinic: users.working_clinic_id > clinics.clinic_id
Ref refresh_tokens_user: refresh_tokens.user_id > users.user_id
Ref blacklisted_tokens_user: blacklisted_tokens.user_id > users.user_id

Ref pets_owner: pets.user_id > users.user_id

Ref clinics_owner: clinics.owner_id > users.user_id
Ref clinic_images_clinic: clinic_images.clinic_id > clinics.clinic_id
Ref clinic_price_per_km_clinic: clinic_price_per_km.clinic_id - clinics.clinic_id
Ref chat_auto_reply_settings_clinic: chat_auto_reply_settings.clinic_id > clinics.clinic_id

Ref clinic_services_clinic: clinic_services.clinic_id > clinics.clinic_id
Ref clinic_services_master: clinic_services.master_service_id > master_services.master_service_id
Ref clinic_services_vaccine_template: clinic_services.vaccine_template_id > vaccine_templates.vaccine_template_id
Ref service_weight_prices_service: service_weight_prices.service_id > clinic_services.service_id
Ref service_weight_prices_master: service_weight_prices.master_service_id > master_services.master_service_id
Ref vaccine_dose_prices_service: vaccine_dose_prices.service_id > clinic_services.service_id

Ref staff_shifts_staff: staff_shifts.staff_id > users.user_id
Ref staff_shifts_clinic: staff_shifts.clinic_id > clinics.clinic_id
Ref slots_shift: slots.shift_id > staff_shifts.shift_id

Ref bookings_pet: bookings.pet_id > pets.pet_id
Ref bookings_pet_owner: bookings.pet_owner_id > users.user_id
Ref bookings_clinic: bookings.clinic_id > clinics.clinic_id
Ref bookings_assigned_staff: bookings.assigned_staff_id > users.user_id
Ref bookings_proxy_booker: bookings.proxy_booker_id > users.user_id
Ref booking_services_booking: booking_services.booking_id > bookings.booking_id
Ref booking_services_pet: booking_services.pet_id > pets.pet_id
Ref booking_services_service: booking_services.service_id > clinic_services.service_id
Ref booking_services_assigned_staff: booking_services.assigned_staff_id > users.user_id
Ref booking_slots_booking: booking_slots.booking_id > bookings.booking_id
Ref booking_slots_slot: booking_slots.slot_id > slots.slot_id
Ref booking_slots_service: booking_slots.booking_service_id > booking_services.booking_service_id
Ref payments_booking: payments.booking_id - bookings.booking_id
Ref reviews_booking: reviews.booking_id - bookings.booking_id
Ref reviews_clinic: reviews.clinic_id > clinics.clinic_id
Ref reviews_user: reviews.user_id > users.user_id

Ref notifications_user: notifications.user_id > users.user_id
Ref notifications_clinic: notifications.clinic_id > clinics.clinic_id
Ref notifications_shift: notifications.shift_id > staff_shifts.shift_id

Ref prompt_versions_agent: prompt_versions.agent_id > agents.id

// Logical application-level relation (documented only, no FK):
// tools.assigned_agents -> agents.name
