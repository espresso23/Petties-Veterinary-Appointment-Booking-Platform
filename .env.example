# ============================================
# PETTIES - Unified Deploy Environment Template
# Copy this file to .env.prod or .env.test and fill in values.
# Deploy command can reuse one compose file:
#   docker compose -p "$COMPOSE_PROJECT_NAME" -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ============================================

# ============================================
# COMPOSE / DEPLOY RUNTIME
# ============================================
COMPOSE_PROJECT_NAME=petties-prod
DEPLOY_ENV=prod
BUILD_ENV=prod

# Host port mapping for container services
BACKEND_HOST_PORT=8080
AI_HOST_PORT=8000
NGINX_HOST_PORT=80

# Nginx template variables
NGINX_SERVER_NAME=api.petties.world
NGINX_FRONTEND_UPSTREAM=https://www.petties.world
NGINX_FRONTEND_HOST=www.petties.world
NGINX_RESOLVER=8.8.8.8

# ============================================
# APP ENVIRONMENT
# ============================================
SPRING_PROFILES_ACTIVE=prod
ENVIRONMENT=production
APP_DEBUG=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ============================================
# DATABASE - SPRING BACKEND
# ============================================
DB_HOST=ep-production.neon.tech
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-me

# ============================================
# DATABASE - AI SERVICE
# ============================================
DATABASE_URL=postgresql://postgres:replace-me@ep-production.neon.tech:5432/postgres
MONGO_URI=mongodb+srv://admin:replace-me@cluster.mongodb.net/petties_nosql?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://admin:replace-me@cluster.mongodb.net/petties_nosql?retryWrites=true&w=majority
MONGODB_DATABASE=petties_nosql

# ============================================
# AUTH
# ============================================
JWT_SECRET=replace-with-64-char-random-secret
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# ============================================
# EMAIL
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://your-redis-host:6379/0
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
REDIS_SSL=true

# ============================================
# EXTERNAL SERVICES
# ============================================
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
GOONG_API_KEY=replace-me
SEPAY_API_TOKEN=replace-me

# ============================================
# AI / LLM
# ============================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
COHERE_API_KEY=replace-me
QDRANT_COLLECTION_NAME=petties_knowledge_base
CASE_MEMORY_COLLECTION=petties_case_memory_v2

# ============================================
# CORS
# ============================================
CORS_ORIGINS=https://petties.world,https://www.petties.world,https://api.petties.world

# ============================================
# OBSERVABILITY
# ============================================
SENTRY_BACKEND_DSN=
SENTRY_AI_SERVICE_DSN=
SENTRY_ENABLED=true

# ============================================
# RESOURCE TUNING (optional)
# ============================================
BACKEND_MEMORY_LIMIT=512M
BACKEND_MEMORY_RESERVATION=384M
AI_MEMORY_LIMIT=384M
AI_MEMORY_RESERVATION=256M
BACKEND_JAVA_OPTS="-Xmx320m -Xms256m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m"


