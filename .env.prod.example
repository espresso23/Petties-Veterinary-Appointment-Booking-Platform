# ============================================
# PETTIES - Production Environment Example
# Use with docker-compose.prod.yml
# ============================================

COMPOSE_PROJECT_NAME=petties-prod
DEPLOY_ENV=prod
BUILD_ENV=prod

BACKEND_HOST_PORT=8080
AI_HOST_PORT=8000
NGINX_HOST_PORT=80

# Nginx
NGINX_SERVER_NAME=api.petties.world
NGINX_FRONTEND_UPSTREAM=https://www.petties.world
NGINX_FRONTEND_HOST=www.petties.world
NGINX_RESOLVER=8.8.8.8

# Runtime profile
SPRING_PROFILES_ACTIVE=prod
ENVIRONMENT=production
APP_DEBUG=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Backend DB (Spring)
DB_HOST=ep-production.neon.tech
DB_PORT=5432
DB_NAME=petties_db
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-me
MONGO_URI=mongodb+srv://user:replace-me@cluster.mongodb.net/petties_nosql?retryWrites=true&w=majority

# AI DB
DATABASE_URL=postgresql://neondb_owner:replace-me@ep-production.neon.tech:5432/petties_db?sslmode=require
MONGODB_URL=mongodb+srv://user:replace-me@cluster.mongodb.net/petties_nosql?retryWrites=true&w=majority
MONGODB_DATABASE=petties_nosql

# Auth
JWT_SECRET=replace-with-64-char-random-secret
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_IDS=
GOOGLE_IOS_CLIENT_ID=

# Firebase
FIREBASE_PROJECT_ID=petties-app
FIREBASE_CREDENTIALS_PATH=

# JWT expiration
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password

# Redis (Backend)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-me

# Media / Maps
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
GOONG_API_KEY=replace-me

# SePay
SEPAY_API_TOKEN=replace-me
SEPAY_BASE_URL=https://my.sepay.vn/userapi
SEPAY_ACCOUNT_NUMBER=YOUR_SEPAY_ACCOUNT_NUMBER
SEPAY_QR_ACC=YOUR_SEPAY_ACCOUNT_NUMBER
SEPAY_QR_BANK=YOUR_SEPAY_BANK_CODE

# CORS
CORS_ORIGINS=https://petties.world,https://www.petties.world,https://api.petties.world

# Observability
SENTRY_BACKEND_DSN=
SENTRY_AI_SERVICE_DSN=

# App version metadata
APP_VERSION=1.0.0

# AI service metadata/runtime
AI_APP_NAME=Petties Agent Service
AI_APP_ENV=production
AI_WORKERS=2

# AI LLM/RAG
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
COHERE_API_KEY=REPLACE_ME
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0
QDRANT_URL=https://YOUR_QDRANT_CLUSTER_ID.qdrant.io
QDRANT_API_KEY=REPLACE_ME
QDRANT_COLLECTION_NAME=petties_knowledge_base
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
JINA_API_KEY=
JINA_IMAGE_EMBED_MODEL=jina-clip-v2

# AI auth/upload/logging
MCP_TIMEOUT=30
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIR=./uploads
AI_LOG_LEVEL=INFO
AI_LOG_FILE=./logs/agent_service.log

# Resource tuning
BACKEND_MEMORY_LIMIT=512M
BACKEND_MEMORY_RESERVATION=384M
BACKEND_JAVA_OPTS=-Xmx320m -Xms256m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m
AI_MEMORY_LIMIT=384M
AI_MEMORY_RESERVATION=256M
