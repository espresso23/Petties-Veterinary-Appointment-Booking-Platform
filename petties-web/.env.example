# ============================================
# PETTIES WEB - Environment Variables
# Copy to .env and modify as needed
# ============================================

# ============================================
# ENVIRONMENT MODE
# ============================================
# development | production
VITE_APP_ENV=development

# ============================================
# API CONFIGURATION
# ============================================
# Development: http://localhost:8080/api
# Production:  https://petties-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# WebSocket URL
# Development: ws://localhost:8080/ws
# Production:  wss://petties-backend.onrender.com/ws
VITE_WS_URL=ws://localhost:8080/ws

# AI Agent Service base URL (legacy/common)
# - Dev (local FastAPI):        http://localhost:8000
# - Dev (ngrok trực tiếp AI):   https://<your-ngrok-domain>.ngrok-free.dev
# - Prod (AI domain riêng):     https://ai.petties.world
VITE_AGENT_SERVICE_URL=http://localhost:8000

# AI REST base URL
# - Dedicated AI service/domain: giống VITE_AGENT_SERVICE_URL
# - Unified nginx/ngrok proxy:   thêm /ai ở cuối
#   Ví dụ: https://<your-ngrok-domain>.ngrok-free.dev/ai
VITE_AGENT_API_BASE_URL=http://localhost:8000

# AI WebSocket base URL
# - Dedicated AI service/domain: ws://localhost:8000 hoặc wss://ai.petties.world
# - Unified nginx/ngrok proxy:   dùng root domain, KHÔNG thêm /ai
#   Ví dụ: wss://<your-ngrok-domain>.ngrok-free.dev
VITE_AGENT_WS_BASE_URL=ws://localhost:8000

# ============================================
# APP CONFIGURATION
# ============================================
VITE_APP_NAME=Petties

# Enable debug mode (true/false)
VITE_DEBUG=true